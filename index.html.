
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>CORRECT PREDICT | Football Intelligence</title>
<style>
:root{
--bg:#080B18;--panel:#141B30;--panel2:#202943;
--gold:#F5C542;--pink:#E83E91;--cyan:#42D9E8;
--white:#F5F7FF;--muted:#A7B0C5;--green:#29C987;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--white);font-family:Arial,sans-serif}
header{padding:18px;background:#10182C;border-bottom:2px solid var(--gold);position:sticky;top:0;z-index:10}
.brand{font-size:25px;font-weight:900;color:var(--gold)}
.brand span{color:var(--cyan)}
header p{font-size:11px;color:var(--muted);margin:5px 0 0}
nav{display:flex;gap:7px;overflow-x:auto;background:#0D1426;padding:12px}
nav button{white-space:nowrap;background:var(--panel2);color:white;border:1px solid #34415F;padding:11px;border-radius:7px}
nav button.active{background:var(--gold);color:#111}
main{max-width:1000px;margin:auto;padding:16px}
.page{display:none}
.page.active{display:block}
h2{color:var(--gold)}
h3{color:var(--cyan)}
.card{background:var(--panel);border:1px solid #293653;border-radius:12px;padding:17px;margin:14px 0}
.hero{text-align:center;padding:35px 15px;background:linear-gradient(130deg,#17233D,#101629);border:1px solid var(--gold);border-radius:14px}
.hero h1{color:var(--gold)}
button{cursor:pointer}
.btn{background:var(--gold);color:#111;border:0;padding:12px 17px;border-radius:7px;font-weight:bold;margin:4px}
.cyan{background:var(--cyan)}
.red{background:var(--pink);color:white}
input,select,textarea{width:100%;padding:12px;background:#0D1426;color:white;border:1px solid #34415F;border-radius:7px;margin:7px 0 13px}
label{font-size:13px;color:var(--muted)}
.match{padding:12px 0;border-bottom:1px solid #34415F}
.odds{color:var(--gold);font-weight:bold}
.muted,.small{color:var(--muted);font-size:13px}
.notice{padding:12px;background:#19243B;border-left:3px solid var(--cyan);margin:12px 0;font-size:13px}
.watermark{font-size:32px;font-weight:900;color:rgba(245,197,66,.15);text-align:center;padding:20px}
.status{color:var(--green)}
.hidden{display:none!important}
table{width:100%;border-collapse:collapse;font-size:13px}
td,th{padding:10px 5px;border-bottom:1px solid #34415F;text-align:left}
th{color:var(--gold)}
footer{text-align:center;padding:25px;color:var(--muted);font-size:12px}
@media(max-width:500px){main{padding:10px}.hero h1{font-size:23px}}
</style>
</head>
<body>

<header>
<div class="brand">CORRECT <span>PREDICT</span></div>
<p>FOOTBALL INTELLIGENCE • STATISTICS • ANALYSIS</p>
</header>

<nav>
<button class="active" onclick="page('home',this)">HOME</button>
<button onclick="page('premium',this)">5+ ODDS</button>
<button onclick="page('daily',this)">DAILY ANALYSIS</button>
<button onclick="page('gg',this)">GG</button>
<button onclick="page('over',this)">OVER/UNDER</button>
<button onclick="page('scores',this)">CORRECT SCORES</button>
<button onclick="page('corners',this)">CORNERS</button>
<button onclick="page('subscription',this)">SUBSCRIPTION</button>
<button onclick="page('about',this)">ABOUT</button>
<button onclick="page('admin',this)">ADMIN</button>
</nav>

<main>

<section id="home" class="page active">
<div class="hero">
<p class="small">WELCOME TO</p>
<h1>CORRECT PREDICT</h1>
<p>Smart football analysis. Statistical predictions. Better decisions.</p>
<button class="btn" onclick="page('daily')">DAILY ANALYSIS</button>
<button class="btn cyan" onclick="page('premium')">PREMIUM ODDS</button>
</div>

<div class="card">
<h2>⭐ PREMIUM 5+ ODDS</h2>
<p>Access our premium football selections and analysis.</p>
<div id="homePremium"></div>
<button class="btn" onclick="page('premium')">VIEW PREMIUM</button>
</div>

<div class="card">
<h2>📊 DAILY PREDICTIONS</h2>
<p>Explore football matches and statistical analysis.</p>
<button class="btn cyan" onclick="page('daily')">OPEN ANALYSIS</button>
</div>

<div class="card">
<h2>OUR CATEGORIES</h2>
<button class="btn" onclick="page('gg')">GG</button>
<button class="btn" onclick="page('over')">OVER/UNDER</button>
<button class="btn" onclick="page('scores')">CORRECT SCORES</button>
<button class="btn" onclick="page('corners')">TEAM CORNERS</button>
</div>
</section>

<section id="premium" class="page">
<h2>⭐ PREMIUM 5+ ODDS</h2>
<p class="muted">Premium selections and detailed match analysis.</p>
<div id="premiumContent"></div>
<div id="premiumLock" class="card">
<div class="watermark">PREMIUM CONTENT</div>
<h3>MEMBERS ONLY</h3>
<p>Subscribe to unlock premium predictions.</p>
<button class="btn" onclick="page('subscription')">SUBSCRIBE KSH 50</button>
</div>
</section>

<section id="daily" class="page">
<h2>📊 DAILY ANALYSIS</h2>
<p class="muted">Match form, home and away performance, goals and probabilities.</p>
<div id="dailyContent"></div>
</section>

<section id="gg" class="page">
<h2>⚽ BOTH TEAMS TO SCORE</h2>
<p class="muted">GG selections based on scoring and defensive statistics.</p>
<div id="ggContent"></div>
</section>

<section id="over" class="page">
<h2>📈 OVER / UNDER 2.5</h2>
<p class="muted">Goal expectations and statistical analysis.</p>
<div id="overContent"></div>
</section>

<section id="scores" class="page">
<h2>🎯 CORRECT SCORES</h2>
<p class="muted">Predicted scorelines with supporting analysis.</p>
<div id="scoresContent"></div>
</section>

<section id="corners" class="page">
<h2>🚩 TEAM CORNERS</h2>
<p class="muted">Team corner statistics and selections.</p>
<div id="cornersContent"></div>
</section>

<section id="subscription" class="page">
<h2>👑 MY SUBSCRIPTION</h2>
<div class="card">
<h3>DAILY PREMIUM ACCESS</h3>
<h1 class="gold">KSH 50</h1>
<p>Daily premium access for 24 hours after approval.</p>
<div class="notice">Pay using M-Pesa Pochi la Biashara.</div>
<button class="btn" onclick="document.getElementById('paymentForm').classList.toggle('hidden')">PAY TO SUBSCRIBE</button>

<div id="paymentForm" class="hidden">
<h3>M-PESA PAYMENT DETAILS</h3>
<h2>0741342508</h2>
<label>Your full name</label>
<input id="payerName" placeholder="Enter your name">
<label>Your phone number</label>
<input id="payerPhone" placeholder="07XXXXXXXX">
<label>M-Pesa transaction code</label>
<input id="transactionCode" placeholder="Enter transaction code">
<button class="btn cyan" onclick="sendPayment()">SUBMIT PAYMENT</button>
</div>
</div>
<div class="card">
<h3>MY ACCESS STATUS</h3>
<div id="accessStatus"></div>
</div>
</section>

<section id="about" class="page">
<h2>ABOUT CORRECT PREDICT</h2>
<div class="card">
<h3>OUR MISSION</h3>
<p>To provide football enthusiasts with structured match analysis, statistics and informed predictions.</p>
<h3>OUR ANALYSIS</h3>
<p>We examine team form, home and away performance, goals scored, defensive records, head-to-head records and available statistics.</p>
<p class="gold">Predictions are probabilities, not guarantees. No outcome is certain.</p>
</div>
</section>

<section id="admin" class="page">
<h2>⚙ ADMIN DASHBOARD</h2>
<div class="card" id="loginBox">
<h3>ADMIN LOGIN</h3>
<label>Administrator password</label>
<input id="adminPassword" type="password" placeholder="Admin password">
<button class="btn" onclick="login()">LOGIN</button>
<p class="small">Demo login only. Replace with secure server-side authentication before public launch.</p>
<div id="loginMessage"></div>
</div>

<div id="adminPanel" class="hidden">

<div class="card">
<h3>PUBLISH PREDICTION</h3>
<label>Match</label>
<input id="match" placeholder="Team A vs Team B">

<label>Prediction category</label>
<select id="category">
<option value="premium">5+ Odds Premium</option>
<option value="daily">Daily Analysis</option>
<option value="gg">GG</option>
<option value="over">Over/Under 2.5</option>
<option value="scores">Correct Scores</option>
<option value="corners">Team Corners</option>
</select>

<label>Prediction</label>
<input id="prediction" placeholder="Enter selection">

<label>Odds (optional)</label>
<input id="matchOdds" placeholder="Example: 1.85">

<label>Probability (optional)</label>
<input id="probability" placeholder="Example: 65%">

<label>Analysis</label>
<textarea id="analysis" rows="4" placeholder="Enter match statistics and reasoning"></textarea>

<button class="btn" onclick="publish()">PUBLISH PREDICTION</button>
</div>

<div class="card">
<h3>MANAGE PREDICTIONS</h3>
<div id="managePredictions"></div>
</div>

<div class="card">
<h3>M-PESA PAYMENT REQUESTS</h3>
<div id="paymentRequests"></div>
</div>

<div class="card">
<h3>API CONFIGURATION</h3>
<p class="small">API keys should be configured on a secure backend, never exposed in public website code.</p>
<label>API key status</label>
<p>Backend connection not configured.</p>
</div>

<div class="card">
<h3>ADMIN SESSION</h3>
<button class="btn red" onclick="logout()">LOG OUT</button>
</div>
</div>
</section>

</main>

<footer>
<strong>CORRECT PREDICT</strong>
<p>Football Intelligence • Statistics • Analysis</p>
<p>Predictions are not guaranteed. Bet responsibly.</p>
</footer>

<script>
const ADMIN_PASSWORD="ChangeThisAdminPassword";

function getData(key){
try{return JSON.parse(localStorage.getItem(key)||"[]")}
catch(e){return []}
}
function saveData(key,data){
localStorage.setItem(key,JSON.stringify(data));
}
function page(id,btn){
document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
document.getElementById(id).classList.add("active");
document.querySelectorAll("nav button").forEach(b=>b.classList.remove("active"));
if(btn)btn.classList.add("active");
refresh();
window.scrollTo(0,0);
}

function isSubscribed(){
let expiry=Number(localStorage.getItem("subscriptionExpiry")||0);
return expiry>Date.now();
}

function renderPredictions(category,elementId,locked){
let data=getData("predictions").filter(x=>x.category===category);
let el=document.getElementById(elementId);
if(!data.length){
el.innerHTML='<div class="card"><p class="muted">No predictions published yet.</p></div>';
return;
}
if(locked&&!isSubscribed()){
el.innerHTML='<div class="card"><div class="watermark">PREMIUM</div><p>Subscribe to unlock these selections.</p></div>';
return;
}
el.innerHTML=data.map(x=>`
<div class="card">
<h3>${safe(x.match)}</h3>
<div class="match"><span>Prediction</span><strong class="gold">${safe(x.prediction)}</strong></div>
${x.odds?`<div class="match"><span>Odds</span><strong class="odds">${safe(x.odds)}</strong></div>`:""}
${x.probability?`<div class="match"><span>Probability</span><strong>${safe(x.probability)}</strong></div>`:""}
<p>${safe(x.analysis)}</p>
<p class="small">Published: ${new Date(x.date).toLocaleString()}</p>
</div>`).join("");
}

function safe(value){
return String(value||"").replace(/[&<>"']/g,c=>({
"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
}[c]));
}

function refresh(){
renderPredictions("premium","premiumContent",true);
renderPredictions("daily","dailyContent",false);
renderPredictions("gg","ggContent",false);
renderPredictions("over","overContent",false);
renderPredictions("scores","scoresContent",false);
renderPredictions("corners","cornersContent",false);
renderHomePremium();
updateAccess();
}

function renderHomePremium(){
let el=document.getElementById("homePremium");
let data=getData("predictions").filter(x=>x.category==="premium");
if(!data.length){
el.innerHTML='<p class="muted">Premium selections will appear here when published.</p>';
}else{
el.innerHTML='<div class="watermark">PREMIUM ODDS</div><p>'+data.length+' premium selection(s) available.</p>';
}
}

function login(){
if(document.getElementById("adminPassword").value===ADMIN_PASSWORD){
sessionStorage.setItem("cpAdmin","yes");
showAdmin();
document.getElementById("loginMessage").textContent="";
}else{
document.getElementById("loginMessage").textContent="Incorrect password.";
}
}

function showAdmin(){
document.getElementById("loginBox").classList.add("hidden");
document.getElementById("adminPanel").classList.remove("hidden");
renderAdmin();
}

function logout(){
sessionStorage.removeItem("cpAdmin");
document.getElementById("loginBox").classList.remove("hidden");
document.getElementById("adminPanel").classList.add("hidden");
document.getElementById("adminPassword").value="";
}

function publish(){
let match=document.getElementById("match").value.trim();
let prediction=document.getElementById("prediction").value.trim();
if(!match||!prediction){
alert("Enter the match and prediction.");
return;
}
let data=getData("predictions");
data.unshift({
id:Date.now(),
match,
category:document.getElementById("category").value,
prediction,
odds:document.getElementById("matchOdds").value,
probability:document.getElementById("probability").value,
analysis:document.getElementById("analysis").value,
date:new Date().toISOString()
});
saveData("predictions",data);
["match","prediction","matchOdds","probability","analysis"].forEach(id=>document.getElementById(id).value="");
alert("Prediction published.");
refresh();
renderAdmin();
}

function deletePrediction(id){
if(!confirm("Delete this prediction?"))return;
saveData("predictions",getData("predictions").filter(x=>x.id!==id));
refresh();
renderAdmin();
}

function sendPayment(){
let name=document.getElementById("payerName").value.trim();
let phone=document.getElementById("payerPhone").value.trim();
let code=document.getElementById("transactionCode").value.trim();
if(!name||!phone||!code){
alert("Complete all payment details.");
return;
}
let requests=getData("paymentRequests");
requests.unshift({
id:Date.now(),name,phone,code,status:"Pending",date:new Date().toISOString()
});
saveData("paymentRequests",requests);
alert("Payment request submitted. Wait for administrator verification.");
document.getElementById("paymentForm").classList.add("hidden");
["payerName","payerPhone","transactionCode"].forEach(id=>document.getElementById(id).value="");
refresh();
}

function approvePayment(id){
let requests=getData("paymentRequests");
let request=requests.find(x=>x.id===id);
if(!request)return;
if(request.status!=="Pending")return;
if(!confirm("Confirm that you have independently verified this M-Pesa payment?"))return;
request.status="Approved";
request.approvedAt=Date.now();
saveData("paymentRequests",requests);
localStorage.setItem("subscriptionExpiry",String(Date.now()+24*60*60*1000));
renderAdmin();
refresh();
}

function rejectPayment(id){
let requests=getData("paymentRequests");
let request=requests.find(x=>x.id===id);
if(request)request.status="Rejected";
saveData("paymentRequests",requests);
renderAdmin();
}

function renderAdmin(){
let data=getData("predictions");
document.getElementById("managePredictions").innerHTML=data.length?data.map(x=>`
<div class="match">
<div><strong>${safe(x.match)}</strong><br><span class="small">${safe(x.category)} — ${safe(x.prediction)}</span></div>
<button class="btn red" onclick="deletePrediction(${x.id})">DELETE</button>
</div>`).join(""):"No predictions published.";

let requests=getData("paymentRequests");
document.getElementById("paymentRequests").innerHTML=requests.length?requests.map(x=>`
<div class="card">
<strong>${safe(x.name)}</strong>
<p>Phone: ${safe(x.phone)}</p>
<p>Transaction: ${safe(x.code)}</p>
<p>Status: ${safe(x.status)}</p>
${x.status==="Pending"?`
<button class="btn cyan" onclick="approvePayment(${x.id})">VERIFY & APPROVE</button>
<button class="btn red" onclick="rejectPayment(${x.id})">REJECT</button>`:""}
</div>`).join(""):"No payment requests.";
}

function updateAccess(){
let el=document.getElementById("accessStatus");
if(isSubscribed()){
let expiry=new Date(Number(localStorage.getItem("subscriptionExpiry")));
el.innerHTML='<p class="status">ACTIVE SUBSCRIPTION</p><p>Expires: '+expiry.toLocaleString()+'</p>';
}else{
el.innerHTML='<p class="muted">No active subscription. Submit payment to request access.</p>';
localStorage.removeItem("subscriptionExpiry");
}
}

function start(){
refresh();
if(sessionStorage.getItem("cpAdmin")==="yes")showAdmin();
}
start();
</script>
</body>
</html>
