}
label{
  color:var(--muted);
  font-size:13px;
}
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:13px;
}
.stat{
  background:var(--panel2);
  padding:14px;
  border-radius:9px;
}
.stat strong{
  display:block;
  color:var(--gold);
  font-size:22px;
  margin-top:7px;
}
.muted{color:var(--muted)}
.gold{color:var(--gold)}
.magenta{color:var(--magenta)}
.cyan{color:var(--cyan)}
.green{color:var(--green)}
.red{color:var(--red)}
.fixture{
  background:var(--panel);
  border:1px solid #34415F;
  padding:15px;
  border-radius:10px;
  margin-bottom:12px;
}
.teams{
  font-size:17px;
  font-weight:bold;
  margin-bottom:10px;
}
.prediction{
  display:flex;
  justify-content:space-between;
  gap:8px;
  flex-wrap:wrap;
  padding:9px 0;
  border-top:1px solid #303B55;
}
.badge{
  background:#352A43;
  color:var(--gold);
  padding:5px 9px;
  border-radius:5px;
  font-size:12px;
}
.notice{
  background:#30291A;
  border:1px solid var(--gold);
  padding:13px;
  border-radius:8px;
  color:#FFE6A0;
  margin:12px 0;
