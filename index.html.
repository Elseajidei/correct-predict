footer{
  text-align:center;
  color:var(--muted);
  padding:25px 10px;
  border-top:1px solid #26314B;
  margin-top:30px;
  font-size:12px;
}
hr{border:0;border-top:1px solid #303B55;margin:18px 0}
.hidden{display:none}
</style>
</head>

