
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CORRECT PREDICT | Football Intelligence</title>
<style>
:root{
--bg:#080B18;
--panel:#131B32;
--panel2:#202B48;
--gold:#F5C542;
--magenta:#E83EAD;
--white:#fff;
--muted:#AAB3C5;
}
*{box-sizing:border-box}
body{
margin:0;
font-family:Arial,sans-serif;
background:var(--bg);
color:var(--white);
}
header{
background:#10172B;
padding:20px;
text-align:center;
border-bottom:2px solid var(--gold);
}
.logo{
font-size:32px;
font-weight:900;
letter-spacing:2px;
color:var(--gold);
}
header p{color:var(--muted);font-size:12px}
nav{
display:flex;
gap:8px;
overflow-x:auto;
padding:12px;
background:#10172B;
}
nav button{
background:var(--panel2);
color:white;
border:1px solid #35415E;
padding:11px 15px;
border-radius:8px;
white-space:nowrap;
}
nav button.active{
background:var(--gold);
color:#080B18;
font-weight:bold;
}
main{padding:15px;max-width:950px;margin:auto}
.page{display:none}
.page.active{display:block}
h2{color:var(--gold)}
.card{
background:var(--panel);
padding:16px;
border:1px solid #293653;
border-radius:12px;
margin:12px 0;
}
.match{
display:flex;
justify-content:space-between;
align-items:center;
gap:10px;
text-align:center;
}
.team{flex:1}
.team img{
width:42px;
height:42px;
object-fit:contain;
display:block;
margin:auto auto 8px;
}
.vs{color:var(--gold);font-weight:bold}
.watermark{
background:var(--panel2);
padding:13px;
text-align:center;
border-radius:8px;
position:relative;
overflow:hidden;
}
.watermark:after{
content:"CORRECT PREDICT";
position:absolute;
inset:0;
display:grid;
place-items:center;
color:#ffffff18;
font-size:19px;
font-weight:bold;
transform:rotate(-15deg);
pointer-events:none;
}
button{
cursor:pointer;
}
.action{
background:var(--gold);
color:#080B18;
border:0;
padding:12px 18px;
border-radius:8px;
font-weight:bold;
margin-top:10px;
}
input{
width:100%;
padding:12px;
margin:7px 0;
border-radius:7px;
border:1px solid #43516F;
background:var(--panel2);
color:white;
}
.muted{color:var(--muted);font-size:13px}
.hidden{display:none!important}
footer{
text-align:center;
padding:25px;
color:var(--muted);
font-size:12px;
}
</style>
</head>
<body>

<header>
<div class="logo">CORRECT PREDICT</div>
<p>FOOTBALL INTELLIGENCE</p>
</header>

<nav id="navigation">
<button class="active" onclick="showPage('home',this)">HOME</button>
<button onclick="showPage('premium',this)">5+ ODDS</button>
<button onclick="showPage('analysis',this)">ANALYSIS</button>
<button onclick="showPage('gg',this)">GG</button>
<button onclick="showPage('over',this)">OVER/UNDER</button>
<button onclick="showPage('scores',this)">CORRECT SCORE</button>
<button onclick="showPage('corners',this)">CORNERS</button>
<button onclick="showPage('subscription',this)">SUBSCRIPTION</button>
</nav>

<main>

<section id="home" class="page active">
<h2>Welcome to CORRECT PREDICT</h2>
<p class="muted">Your football intelligence platform.</p>

<h2>5+ ODDS PREMIUM</h2>
<div class="card">
<div class="match">
<div class="team">
<img src="https://media.api-sports.io/football/teams/50.png" alt="Team logo">
Team A
</div>
<div class="vs">VS</div>
<div class="team">
<img src="https://media.api-sports.io/football/teams/42.png" alt="Team logo">
Team B
</div>
</div>
<div class="watermark">
<strong>ODDS: •••••</strong>
<p class="muted">Premium odds protected</p>
</div>
<button class="action" onclick="showPage('premium')">View Premium Analysis</button>
</div>
</section>

<section id="premium" class="page">
<h2>5+ ODDS PREMIUM</h2>
<p class="muted">High-odds selections with detailed analysis.</p>
<div id="premiumMatches">
<div class="card">
<h3>Premium selections</h3>
<p>Fixtures and selections will appear here after the API/backend is connected.</p>
<p class="muted">Combined odds are only displayed to authorized subscribers.</p>
</div>
</div>
</section>

<section id="analysis" class="page">
<h2>DAILY ANALYSIS</h2>
<p class="muted">Daily top 10 football predictions.</p>
<div id="dailyMatches" class="card">
No daily predictions published yet. Connect the football API and publish predictions through the admin system.
</div>
</section>

<section id="gg" class="page">
<h2>GG PREDICTIONS</h2>
<div class="card">Both teams to score analysis will appear here.</div>
</section>

<section id="over" class="page">
<h2>OVER / UNDER 2.5</h2>
<div class="card">Goal averages and over/under analysis will appear here.</div>
</section>

<section id="scores" class="page">
<h2>CORRECT SCORES</h2>
<div class="card">Correct score predictions and probabilities will appear here.</div>
</section>

<section id="corners" class="page">
<h2>TEAM CORNERS</h2>
<div class="card">Team corner statistics and analysis will appear here.</div>
</section>

<section id="subscription" class="page">
<h2>MY SUBSCRIPTION</h2>
<div class="card">
<p>Daily premium access: <strong>KSh 50</strong></p>
<button class="action" onclick="openPayment()">PAY TO SUBSCRIBE</button>
<div id="paymentDetails" class="hidden">
<h3>Payment instructions</h3>
<p>Pay KSh 50 through M-Pesa Pochi la Biashara.</p>
<p><strong>Payment number: 0741342508</strong></p>
<p>Enter your M-Pesa transaction code below for manual verification.</p>
<input id="transaction" placeholder="M-Pesa transaction code">
<button class="action" onclick="submitPayment()">Submit payment details</button>
</div>
<p id="paymentMessage" class="muted"></p>
</div>
</section>

<section id="admin" class="page">
<h2>ADMIN DASHBOARD</h2>
<div class="card">
<p>Administrator login</p>
<input id="adminPassword" type="password" placeholder="Admin password">
<button class="action" onclick="adminLogin()">LOGIN</button>
<div id="adminPanel" class="hidden">
<h3>API configuration</h3>
<p class="muted">API keys must be stored on a secure backend, not in public HTML.</p>
<p>Backend API URL</p>
<input id="apiUrl" placeholder="https://your-backend.onrender.com">
<button class="action" onclick="saveApiUrl()">Save backend URL</button>
<h3>Prediction publishing</h3>
<textarea id="predictionText" placeholder="Enter prediction and analysis" style="width:100%;height:120px;background:#202B48;color:white;padding:12px"></textarea>
<button class="action" onclick="publishPrediction()">Publish daily analysis</button>
<p id="adminMessage"></p>
</div>
</div>
</section>

</main>

<footer>
CORRECT PREDICT © 2026
<br>Football analysis and probability estimates. No guaranteed outcomes.
</footer>

<script>
function showPage(id,button){
document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
const page=document.getElementById(id);
if(page)page.classList.add('active');
document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));
if(button)button.classList.add('active');
window.scrollTo(0,0);
}

function openPayment(){
document.getElementById('paymentDetails').classList.remove('hidden');
}

function submitPayment(){
const code=document.getElementById('transaction').value.trim();
if(!code){
alert('Enter your M-Pesa transaction code.');
return;
}
document.getElementById('paymentMessage').textContent=
'Payment submitted for manual verification. Access is not activated until confirmed.';
}

function adminLogin(){
const password=document.getElementById('adminPassword').value;
if(password===''){
alert('Enter admin password.');
return;
}
alert('Connect secure admin authentication before using this dashboard.');
}

function saveApiUrl(){
const url=document.getElementById('apiUrl').value.trim();
if(!url)return alert('Enter your backend URL.');
document.getElementById('adminMessage').textContent=
'Backend URL entered. Secure backend integration is still required.';
}

function publishPrediction(){
const prediction=document.getElementById('predictionText').value.trim();
if(!prediction)return alert('Enter analysis first.');
document.getElementById('dailyMatches').textContent=prediction;
document.getElementById('adminMessage').textContent='Preview published on this browser only.';
}
</script>
</body>
</html>
