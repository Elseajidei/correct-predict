<script>

// NAVIGATION

function showPage(id,button){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById(id).classList.add('active');

  document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));

  if(button) button.classList.add('active');
  else {
    const navButton=[...document.querySelectorAll('nav button')]
      .find(b=>b.getAttribute('onclick')?.includes("'"+id+"'"));
    if(navButton) navButton.classList.add('active');
  }
}

// API CONNECTION
// IMPORTANT: This is your own backend address.
// Never place your API-Football secret key in this HTML file.

const API_BASE = "/api";

let fixtures = [];

async function apiRequest(path){
  const response = await fetch(API_BASE + path);

  if(!response.ok){
    throw new Error("Server error: "+response.status);
  }

  return await response.json();
}

// LOAD FIXTURES

async function loadFixtures(){
  const home=document.getElementById("homeFixtures");
  home.innerHTML="<p class='muted'>Loading fixtures...</p>";

  try{
    const data=await apiRequest("/fixtures");

    fixtures=data.fixtures || data;

    if(!Array.isArray(fixtures) || !fixtures.length){
      home.innerHTML="<p>No fixtures available.</p>";
      return;
    }

    const select=document.getElementById("matchSelect");
    select.innerHTML='<option value="">Select a match</option>';

    fixtures.forEach((match,index)=>{
      const option=document.createElement("option");
      option.value=index;
      option.textContent=match.home+" vs "+match.away;
      select.appendChild(option);
    });

    home.innerHTML=fixtures.map((match,index)=>`
      <div class="fixture">
        <div class="teams">
          ${escapeHTML(match.home)} vs ${escapeHTML(match.away)}
        </div>
        <p class="muted">${escapeHTML(match.league || "Football")}</p>
        <button class="primary" onclick="selectMatch(${index})">
          ANALYSE
        </button>
      </div>
    `).join("");

  }catch(error){
    home.innerHTML=`
      <p class="red">Could not load fixtures.</p>
      <p class="muted">
        The secure football API backend must be connected.
      </p>`;
  }
}

function selectMatch(index){
  document.getElementById("matchSelect").value=index;
  showPage("analysis");
  analyseMatch();
}

// MATCH ANALYSIS

async function analyseMatch(){

  const index=document.getElementById("matchSelect").value;
  const result=document.getElementById("analysisResult");
  const details=document.getElementById("detailedAnalysis");

  if(index===""){
    result.innerHTML="<p class='red'>Select a match first.</p>";
    return;
  }

  const match=fixtures[Number(index)];

  result.innerHTML="<p class='muted'>Analysing match statistics...</p>";
  details.innerHTML="";

  try{
    const data=await apiRequest("/analysis/"+encodeURIComponent(match.id));

    if(!data || !data.predictions){
      throw new Error("Incomplete analysis");
    }

    const p=data.predictions;
    const s=data.statistics || {};

    document.getElementById("homeAttack").textContent=s.homeAttack ?? "--";
    document.getElementById("awayAttack").textContent=s.awayAttack ?? "--";
    document.getElementById("homeDefence").textContent=s.homeDefence ?? "--";
    document.getElementById("awayDefence").textContent=s.awayDefence ?? "--";
    document.getElementById("homeGoals").textContent=s.homeAverageGoals ?? "--";
    document.getElementById("awayGoals").textContent=s.awayAverageGoals ?? "--";

    result.innerHTML=`
      <h3>${escapeHTML(match.home)} vs ${escapeHTML(match.away)}</h3>

      <div class="prediction">
        <span>Home win</span>
        <strong class="gold">${percentage(p.homeWin)}</strong>
      </div>
      <div class="prediction">
        <span>Draw</span>
        <strong>${percentage(p.draw)}</strong>
      </div>
      <div class="prediction">
        <span>Away win</span>
        <strong class="magenta">${percentage(p.awayWin)}</strong>
      </div>
      <div class="prediction">
        <span>Both teams score</span>
        <strong class="cyan">${percentage(p.gg)}</strong>
      </div>
      <div class="prediction">
        <span>Over 2.5 goals</span>
        <strong>${percentage(p.over25)}</strong>
      </div>
      <div class="prediction">
        <span>Under 2.5 goals</span>
        <strong>${percentage(p.under25)}</strong>
      </div>
    `;

    const scores=Array.isArray(p.correctScores)?p.correctScores:[];

    details.innerHTML=`
      <div class="card">
        <h3>Top 5 Correct Scores</h3>
        ${scores.slice(0,5).map((s,i)=>`
          <div class="prediction">
            <span>${i+1}. ${escapeHTML(String(s.score))}</span>
            <strong class="gold">${percentage(s.probability)}</strong>
          </div>
        `).join("") || "<p>No correct-score data available.</p>"}
      </div>

      <div class="card">
        <h3>Recent Form</h3>
        <p>Home: ${escapeHTML(s.homeForm || "Unavailable")}</p>
        <p>Away: ${escapeHTML(s.awayForm || "Unavailable")}</p>
        <p>Home last five goals: ${escapeHTML(String(s.homeLastFiveGoals ?? "--"))}</p>
        <p>Away last five goals: ${escapeHTML(String(s.awayLastFiveGoals ?? "--"))}</p>
      </div>

      <div class="card">
        <h3>League Position</h3>
        <p>Home: ${escapeHTML(String(s.homePosition ?? "Unavailable"))}</p>
        <p>Away: ${escapeHTML(String(s.awayPosition ?? "Unavailable"))}</p>
      </div>

      <div class="notice">
        These probabilities are estimates, not guaranteed outcomes.
      </div>
    `;

  }catch(error){
    result.innerHTML=`
      <p class="red">Analysis unavailable.</p>
      <p class="muted">
        Check the secure backend and match statistics connection.
      </p>`;
  }
}

// 5+ ODDS

async function loadHighOdds(){

  const container=document.getElementById("highOddsResults");
  container.innerHTML="<p>Loading analysed selections...</p>";

  try{
    const data=await apiRequest("/high-odds");
    const items=data.selections || [];

    if(!items.length){
      container.innerHTML="<p class='muted'>No verified 5+ odds selections available.</p>";
      return;
    }

    container.innerHTML=items.map(item=>`
      <div class="fixture">
        <div class="teams">
          ${escapeHTML(item.match)}
        </div>
        <p>Selection: <strong class="gold">${escapeHTML(item.selection)}</strong></p>
        <p>Odds: <strong class="cyan">${escapeHTML(String(item.odds))}</strong></p>
        <p>Estimated probability: ${percentage(item.probability)}</p>
        <p class="muted">${escapeHTML(item.reason || "")}</p>
      </div>
    `).join("");

  }catch(error){
    container.innerHTML="<p class='red'>5+ odds service is not connected yet.</p>";
  }
}

// PAYMENT SUBMISSION

document.getElementById("paymentForm").addEventListener("submit",async function(e){

  e.preventDefault();

  const phone=document.getElementById("payerPhone").value.trim();
  const code=document.getElementById("transactionCode").value.trim();
  const message=document.getElementById("paymentMessage");

  if(!/^(\+254|0)?[17]\d{8}$/.test(phone)){
    message.innerHTML="<p class='red'>Enter a valid Kenyan phone number.</p>";
    return;
  }

  if(code.length<6){
    message.innerHTML="<p class='red'>Enter a valid transaction code.</p>";
    return;
  }

  message.innerHTML="<p class='muted'>Submitting verification request...</p>";

  try{
    const response=await fetch(API_BASE+"/payments/verify",{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        phone:phone,
        transactionCode:code,
        amount:50
      })
    });

    if(!response.ok) throw new Error("Submission failed");

    message.innerHTML=`
      <p class='green'>Verification request submitted.</p>
      <p class='muted'>Your subscription remains pending until the administrator verifies your payment.</p>
    `;

  }catch(error){
    message.innerHTML=`
      <p class='red'>Payment verification server is not connected.</p>
      <p class='muted'>Please contact the administrator with your transaction details.</p>
    `;
  }
});

// HELPERS

function percentage(value){
  if(value===undefined || value===null || !Number.isFinite(Number(value))) return "--";
  const n=Number(value);
  return (n<=1 ? n*100 : n).toFixed(1)+"%";
}

function escapeHTML(value){
  return String(value).replace(/[&<>"']/g,char=>({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  })[char]);
}

</script>

